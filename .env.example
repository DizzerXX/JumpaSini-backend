APP_NAME=JumpaSini
APP_ENV=local
APP_KEY=your-app-key-here
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
# Comma-separated browser origins allowed to call this API (defaults to FRONTEND_URL).
CORS_ALLOWED_ORIGINS=http://localhost:4200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# On Render, use the INTERNAL hostname (e.g. dpg-xxxxx-a) for services in the same
# region — the external ...render.com host routes over the public internet and is
# the usual cause of SQLSTATE[08006] "SSL connection has been closed unexpectedly".
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_DATABASE=jumpa_sini
DB_USERNAME=your_username
DB_PASSWORD=your_password
# Managed Postgres (Render/Supabase/RDS) requires SSL; 'prefer' silently downgrades.
DB_SSLMODE=require

# 'array' — this is a token-auth API with no server-side sessions, and the app's own
# `sessions` table (meetup sessions) is not Laravel's session store.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Third-Party API Keys ──────────────────────────────────────────────────────
# All external API calls must go through this backend — never from frontend or mobile.

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
WEATHER_ENABLED=true
MIDPOINT_MAX_IMBALANCE_MINUTES=15
MIDPOINT_MAX_ADJUSTMENT_ITERATIONS=5
VOTING_DURATION_MINUTES=5
VOTING_ENABLED=true

# ─── Admin Panel ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@jumpa.sini
ADMIN_PASSWORD=changeme123
